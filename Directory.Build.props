<Project>
  <PropertyGroup>
    <ClothingOutputRoot Condition="'$(ClothingOutputRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\插件\lemon'))</ClothingOutputRoot>
    <BaseIntermediateOutputPath>$(ClothingOutputRoot)\.build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(ClothingOutputRoot)\.build\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_/ClothingPairing/</PathMap>
    <DebugType>none</DebugType>
    <NuGetAudit>false</NuGetAudit>
    <RestoreSources>$(ClothingOutputRoot)\.build\offline-source</RestoreSources>
    <DalamudDir Condition="'$(DalamudDir)' == ''">$(DALAMUD_HOME)</DalamudDir>
    <DalamudDir Condition="'$(DalamudDir)' == ''">$(APPDATA)\XIVLauncherCN\addon\Hooks\dev</DalamudDir>
  </PropertyGroup>
</Project>
